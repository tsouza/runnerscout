# Copy this file to an untracked location (e.g. tools/e2e/.env - already
# covered by .gitignore's "*.env"/".env" pattern) and `source` it before
# running any tools/e2e/*.sh script. See docs/e2e-qualification.md for what
# each variable means, what it must be provisioned as, and the exact
# scripts that read it. Never commit a filled-in copy of this file - it
# names real credentials and real cloud/GitHub identifiers.
#
# This file covers both the AWS and Azure pieces of issue #80. Fill in only
# the section for the cloud you are actually qualifying - the AWS-prefixed
# and Azure-prefixed variables are read by entirely separate scripts
# (tools/e2e/*.sh vs tools/e2e/*-azure.sh) and never both at once.

# --- Safety gates (tools/e2e/lib.sh) ---
export E2E_CONFIRM_REAL_SPEND='I-UNDERSTAND-THIS-COSTS-REAL-MONEY'
export E2E_MAX_RUNTIME_MINUTES=45   # 1-60, see tools/e2e/lib.sh's hard ceiling

# --- GitHub: target test repository/org and scale set (shared by every
# cloud piece - scale-set registration is a GitHub-side concept, see
# cmd/e2e-register-scale-set's own header comment) ---
export E2E_GITHUB_URL='https://github.com/REPLACE_WITH_OWNER/REPLACE_WITH_TEST_REPO'
export E2E_SCALE_SET_NAME='e2e-aws-qualify'   # e.g. 'e2e-azure-qualify' for the Azure piece
export E2E_RUNNER_GROUP='Default'
export E2E_GITHUB_AUTH_MODE='pat'   # or 'app'
export E2E_GITHUB_TOKEN_FILE='/path/to/mounted/pat-token'
# export E2E_GITHUB_APP_CLIENT_ID='Iv1.REPLACE'
# export E2E_GITHUB_APP_INSTALLATION_ID=1
# export E2E_GITHUB_APP_KEY_FILE='/path/to/mounted/github-app.pem'

# Registered by tools/e2e/register-scale-set.sh - set this AFTER running it:
# export E2E_REGISTERED_SCALE_SET_ID=123

# --- GitHub: workflow to dispatch (usually the same repo as E2E_GITHUB_URL,
# but not required to be - see tools/e2e/dispatch-and-wait.sh/
# dispatch-and-wait-azure.sh) ---
export E2E_TARGET_REPO='REPLACE_WITH_OWNER/REPLACE_WITH_TEST_REPO'
export E2E_TARGET_WORKFLOW='e2e-trivial.yml'
export E2E_TARGET_REF='main'

# --- AWS: reuse the same pinned qualification network documented in
# docs/qualification-real-cloud.md's AWS section. Read by
# tools/e2e/bring-up.sh/dispatch-and-wait.sh/teardown.sh/verify.sh only. ---
export E2E_AWS_REGION='us-east-1'
export E2E_AWS_ACCOUNT_ID='000000000000'
export E2E_AWS_VPC_ID='vpc-00000000000000000'
export E2E_AWS_SUBNET_ID='subnet-00000000000000000'
export E2E_AWS_SECURITY_GROUP_ID='sg-00000000000000000'
export E2E_AWS_AMI_ID='ami-00000000000000000'
export E2E_AWS_INSTANCE_TYPE='t3.micro'
export E2E_AWS_ARCHITECTURE='amd64'
export E2E_AWS_CREDENTIALS_FILE='/path/to/aws-shared-credentials-file'   # must contain a [runnerscout] profile

# --- Azure: reuse the same pinned qualification network documented in
# docs/qualification-real-cloud.md's Azure section. Read by
# tools/e2e/bring-up-azure.sh/dispatch-and-wait-azure.sh/teardown-azure.sh/
# verify-azure.sh only. Azure Workload Identity Federation is the ONLY
# supported credential path here, matching qualify-azure.yml - see
# docs/qualification-real-cloud.md's Azure section for why there is no
# client-secret fallback. An authenticated `az` CLI session (however
# obtained locally) must already be active in the invoking shell before
# running bring-up-azure.sh/dispatch-and-wait-azure.sh/teardown-azure.sh -
# these scripts never run `az login` themselves. ---
export E2E_AZURE_REGION='eastus'
export E2E_AZURE_SUBSCRIPTION_ID='00000000-0000-0000-0000-000000000000'
export E2E_AZURE_RESOURCE_GROUP='runnerscout-e2e-qualify'
export E2E_AZURE_VNET_ID='/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/runnerscout-e2e-qualify/providers/Microsoft.Network/virtualNetworks/runners'
export E2E_AZURE_SUBNET_ID='/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/runnerscout-e2e-qualify/providers/Microsoft.Network/virtualNetworks/runners/subnets/runners'
export E2E_AZURE_NSG_ID='/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/runnerscout-e2e-qualify/providers/Microsoft.Network/networkSecurityGroups/runners'
export E2E_AZURE_IMAGE_ID='/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/runner-images/providers/Microsoft.Compute/images/ubuntu-2404-runner-amd64'
export E2E_AZURE_VM_SIZE='Standard_D2s_v3'
export E2E_AZURE_ZONE='1'   # '1', '2' or '3' - must be supported by both E2E_AZURE_REGION and E2E_AZURE_VM_SIZE
export E2E_AZURE_ARCHITECTURE='amd64'
export E2E_AZURE_CLIENT_ID='REPLACE_WITH_AZURE_AD_APP_CLIENT_ID'
export E2E_AZURE_TENANT_ID='REPLACE_WITH_AZURE_AD_TENANT_ID'
export E2E_AZURE_FEDERATED_TOKEN_FILE='/path/to/a/github-actions-oidc-or-equivalent-federated-token.jwt'

# --- Kubernetes/cluster ---
export E2E_NAMESPACE='runnerscout'
export E2E_CLUSTER_NAME='runnerscout-e2e'
export E2E_IMAGE='runnerscout:e2e'

# --- Evidence ---
export E2E_EVIDENCE_DIR='evidence/e2e-aws-qualify'   # e.g. 'evidence/e2e-azure-qualify' - gitignored, see .gitignore's /evidence/
