# Rendered by tools/e2e/bring-up-azure.sh via envsubst. "separate" mode (not
# "wireguard" - see docs/operations.md's "Known limitations": wireguard mode
# is not yet functionally usable end-to-end, so this harness, like
# examples/multicloud, uses the mode that actually works). One Azure
# mapping, reusing the same pinned qualification network documented in
# docs/qualification-real-cloud.md's Azure section.
apiVersion: runnerscout.io/v1alpha1
kind: NetworkProfile
metadata:
  name: e2e-azure
  namespace: ${E2E_NAMESPACE}
spec:
  mode: separate
  mappings:
    - providerRef:
        name: azure
      region: ${E2E_AZURE_REGION}
      networkID: ${E2E_AZURE_VNET_ID}
      subnetID: ${E2E_AZURE_SUBNET_ID}
      cidrs: [${E2E_AZURE_SUBNET_CIDR}]
