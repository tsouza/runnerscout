# Rendered by tools/e2e/bring-up-azure.sh via envsubst, only when
# E2E_GITHUB_AUTH_MODE=pat. See runner-scaleset-azure-app.yaml.tmpl for the
# App auth equivalent - exactly one of the two is ever applied, matching the
# RunnerScaleSet CRD's own XValidation mutual-exclusion rule
# (api/v1alpha1/types.go's GitHubAuthentication).
#
# This is the Azure sibling of manifests/runner-scaleset-pat.yaml.tmpl - a
# separate file, not a shared/reused one, purely because runnerClassRef.name
# below must point at this piece's own e2e-azure RunnerClass rather than the
# AWS piece's e2e-aws one; every other field is identical and cloud-agnostic
# (scale-set registration is a GitHub-side concept, see cmd/e2e-register-scale-set's
# own header comment).
#
# suspend is deliberately false: unlike examples/multicloud (a documentation
# worked example that must never admit for real), this harness has already
# passed tools/e2e/lib.sh's confirmation-phrase and runtime-ceiling gates by
# the time bring-up-azure.sh applies this file, so there is no separate
# "operator's second explicit go-ahead" step left to gate on here.
apiVersion: runnerscout.io/v1alpha1
kind: RunnerScaleSet
metadata:
  name: ${E2E_SCALE_SET_NAME}
  namespace: ${E2E_NAMESPACE}
spec:
  runnerClassRef:
    name: e2e-azure
  github:
    url: ${E2E_GITHUB_URL}
    scaleSetID: ${E2E_REGISTERED_SCALE_SET_ID}
    auth:
      mode: pat
      secretRef:
        name: github
        key: token
  maxRunners: 1
  provisioningSeconds: ${E2E_PROVISIONING_SECONDS}
  maxLifetimeSeconds: ${E2E_MAX_LIFETIME_SECONDS}
  suspend: false
