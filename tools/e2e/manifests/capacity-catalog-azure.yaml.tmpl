# Rendered by tools/e2e/bring-up-azure.sh via envsubst, using a REAL price
# observation and a fresh observedAt timestamp - never the illustrative,
# permanently-expired quotes examples/multicloud/catalog.yaml ships (see
# that file's own "Illustrative, deliberately expired quotes" header
# comment). The price itself comes from Azure's public, unauthenticated
# Retail Prices API (internal/prices/azure.go's AzureSpotClient), unlike
# AWS's authenticated describe-spot-price-history call - see
# tools/e2e/lib.sh's e2e_refresh_azure_catalog_inputs.
#
# CRD-driven mode has no equivalent of operator.Config.AWSPriceRefresh (that
# flag is only ever set by cmd/runnerscout's mounted-JSON path - see
# internal/configapi/runtime.go, which never reads it from any CRD field) -
# so this catalog's price goes stale (internal/placement.MaxPriceAge, 5
# minutes) if dispatch does not follow shortly after this is applied.
# tools/e2e/dispatch-and-wait-azure.sh re-renders and re-applies this exact
# file immediately before dispatching, specifically to keep this window
# from being a real failure mode - see
# docs/e2e-qualification.background.md.
apiVersion: runnerscout.io/v1alpha1
kind: CapacityCatalog
metadata:
  name: e2e-azure
  namespace: ${E2E_NAMESPACE}
spec:
  offerings:
    - id: azure-spot-e2e
      provider: azure
      region: ${E2E_AZURE_REGION}
      zone: "${E2E_AZURE_ZONE}"
      machine: ${E2E_AZURE_VM_SIZE}
      image: ${E2E_AZURE_IMAGE_ID}
      cpu: ${E2E_AZURE_OFFERING_CPU}
      memoryMiB: ${E2E_AZURE_OFFERING_MEMORY_MIB}
      architecture: ${E2E_AZURE_ARCHITECTURE}
      capabilities: []
      spot: true
      priceMicros: ${E2E_AZURE_PRICE_MICROS}
      currency: USD
      observedAt: "${E2E_AZURE_PRICE_OBSERVED_AT}"
  complete:
    azure: false
