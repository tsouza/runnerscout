/bin/
/work/
# Not anchored to the repo root: `go test ./internal/provider/` runs with
# that package directory as its own working directory, so real-cloud
# qualification evidence (internal/provider/evidence/) lands there, not
# at the repo root - see qualify.yml's "Upload qualification evidence"
# step for the corresponding artifact-path fix.
evidence/
*.test
coverage.out
.env
*.pem
*.key

__pycache__/
*.pyc

/outputs/

# OpenTofu/Terraform local state (tools/tofu/**) - these modules deliberately
# use local state, never a remote backend; the state file itself is
# environment-specific and must never be committed. The provider dependency
# cache is likewise local and reproducible from .terraform.lock.hcl (which
# IS committed).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
