/bin/
/work/
# Not anchored to the repo root: `go test ./internal/provider/` runs with
# that package directory as its own working directory, so real-cloud
# qualification evidence (internal/provider/evidence/) lands there, not
# at the repo root - see qualify.yml's "Upload qualification evidence"
# step for the corresponding artifact-path fix.
evidence/
*.test
coverage.out
.env
*.pem
*.key

__pycache__/
*.pyc

/outputs/

# OpenTofu/Terraform local state (tools/tofu/**) - these modules deliberately
# use local state, never a remote backend; the state file itself is
# environment-specific and must never be committed. The provider dependency
# cache is likewise local and reproducible from .terraform.lock.hcl (which
# IS committed).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# tools/tlc.py downloads this on first run; not committed, not reproducible
# byte-for-byte across TLC releases.
/spec/.tools/
# TLC's own per-run metadata directory (fingerprint set, checkpoints) -
# -cleanup keeps it from accumulating across runs but does not remove the
# directory itself.
/spec/states/

# goreleaser's own output directory (checksums, metadata, release notes -
# see .goreleaser.yml), and the Helm chart package .goreleaser.yml's own
# before.hooks stage outside it (dist/ is goreleaser-owned and errors if
# anything is already there when it starts - see that hook's own comment).
/dist/
/release-artifacts/
# Written by tools/prepare_release.py, consumed by
# prepare-release.yml's own `gh pr create --body-file` step - never
# committed, regenerated fresh by every prepare-release.yml run.
/release-pr-body.md

# `make image`'s scratch staging directory: `goreleaser build
# --single-target` writes the binary here (at linux/$GOARCH/runnerscout,
# matching Docker's own $TARGETPLATFORM convention) so the Dockerfile's
# COPY finds it under a plain `docker build .` - see the Dockerfile's own
# comment. Removed by the same make target; ignored as a safety net if a
# build fails partway through.
/linux/
